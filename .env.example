DATABASE_URL=postgresql://finance_user:finance_password@localhost:5432/finance_db
JWT_SECRET=your_secret_here_min_32_characters_long
JWT_REFRESH_SECRET=your_refresh_secret_here_min_32_characters_long
PORT=3000
# Optional — defaults to https://api.frankfurter.dev/v1 if unset
FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v1
# Optional — defaults to https://api.coingecko.com/api/v3 if unset.
# Fallback source for pairs Frankfurter does not cover (crypto, RUB, ...).
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# Optional — works without one, but the keyless tier allows only ~5 requests
# per minute. A free demo key raises that considerably.
COINGECKO_API_KEY=

# Esplora API used to sync Bitcoin wallets (default https://mempool.space/api)
BITCOIN_ESPLORA_URL=https://mempool.space/api
